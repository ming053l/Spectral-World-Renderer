    "source_path": "${ABGS_DATA_ROOT}/hs_nerf/basil/source",
    "anchor": "${ABGS_MODELS_ROOT}/basil/reference/anchor"
  },
  "paper_model": {
    "anchor_ply": "${ABGS_MODELS_ROOT}/basil/anchor/point_cloud.ply",
    "source": "${ABGS_MODELS_ROOT}/basil/source/ckpt.pt",
    "model": "${ABGS_MODELS_ROOT}/basil/decoder/model_ema.pt"
  }
}
