{
  "extends": "hs_nerf",
  "description": "HS-NeRF basil: real capture, reference preset, K = 16, seed 42",
  "scene_id": "hsnerf_basil",
  "data": {
    "anchor_scene": "${ABGS_DATA_ROOT}/hs_nerf/basil/anchor_input"
  },
  "packs": {
    "train": "${ABGS_DATA_ROOT}/packs/basil/train",
    "eval": "${ABGS_DATA_ROOT}/packs/basil/eval"
  },
  "pack_export": {
